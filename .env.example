# Default is local Ollama. Use only a verified local address.
AVOCADO_INFERENCE_URL=http://127.0.0.1:11434
# Only needed if your local route requires authentication; never commit real keys.
AVOCADO_API_KEY=
# Set this in the Ollama SERVER environment before starting/restarting Ollama.
OLLAMA_NO_CLOUD=1

# Local Transformers checkpoint directory for native video input (not an Ollama tag).
AVOCADO_VIDEO_MODEL=models/Qwen3-VL-8B-Instruct
