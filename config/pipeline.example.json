{
  "version": 1,
  "models": {"vision": "qwen3-vl:8b-instruct", "processing": "qwen3.5:9b", "reasoning": "qwen3.5:9b"},
  "steps": [
    {"id":"sample","kind":"sample","inputs":{"video":"$video"},"settings":{"count":8,"seconds":12}},
    {"id":"observe","kind":"observe","inputs":{"frames":"$sample.frames"},"settings":{"temperature":0.2,"num_predict":4096,"think":false,"format":"json"},"model":"vision","prompt":"@prompts/observe.txt","extra":{}},
    {"id":"validate","kind":"validate","inputs":{"observations":"$observe","frames":"$sample.frames"},"settings":{}},
    {"id":"process","kind":"process","inputs":{"observations":"$validate"},"settings":{"temperature":0.2,"num_predict":3072,"think":false,"format":"json"},"model":"processing","prompt":"@prompts/process.txt","extra":{}},
    {"id":"rank","kind":"rank","inputs":{"observations":"$validate","context":"$context","rubric":"$rubric","attributes":"$process"},"settings":{"temperature":0.2,"num_predict":3072,"think":false,"format":"json"},"model":"reasoning","prompt":"@prompts/rank.txt","extra":{}}
  ]
}
