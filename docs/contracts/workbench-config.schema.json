{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:avocadoeyes:workbench-config:1",
  "$comment":"Owner: repository maintainers (assignment pending #1). Consumers: runner and editor. Breaking changes require new version/migration. Validate examples and negative fixtures in CI. https://github.com/vrindaat/AVocadoEyes/issues/1",
  "type":"object","additionalProperties":false,"required":["version","models","steps"],
  "properties":{
    "version":{"const":1},
    "models":{"type":"object","additionalProperties":{"type":"string","minLength":1}},
    "steps":{"type":"array","minItems":1,"maxItems":32,"items":{
      "type":"object","additionalProperties":false,"required":["id","kind","inputs","settings"],"properties":{
        "id":{"type":"string","pattern":"^[a-z][a-z0-9_-]*$"},
        "kind":{"type":"string","minLength":1},
        "inputs":{"type":"object","additionalProperties":{"type":"string","pattern":"^\\$[a-z][a-z0-9_.-]*$"}},
        "settings":{"type":"object"},"prompt":{"type":"string"},"model":{"type":"string"},"extra":{"type":"object"}
      }
    }}
  }
}
